    kv_iswa --> kv : kv_base
    kv_iswa --> kv : kv_swa
    kv_dsa --> kv : kv_mla
    kv_dsa --> kv : kv_lid
    hybrid --> kv : mem_attn
    hybrid --> recurrent : mem_recr
    hybrid_iswa --> kv_iswa : mem_attn
    hybrid_iswa --> recurrent : mem_recr

    create_memory --> arch_check : queries
    create_memory --> kv : creates (attention)
    create_memory --> recurrent : creates (recurrent archs)
    create_memory --> hybrid : creates (hybrid archs)
    create_memory --> hybrid_iswa : creates (hybrid + SWA)
    create_memory --> kv_dsa : creates (DeepSeek)
    create_memory --> kv_iswa : creates (attention + SWA)

    ctx_ctor --> create_memory : calls
    memory_update --> mem_i : init_update + init_full
    decode --> memory_update : first
    init_batch_call --> mem_i : init_batch
    process_ubatch --> graph : builds graph

    graph --> build_rs : for each recurrent state tensor
    graph --> build_rs_inp : once per graph
    graph --> build_inp_mem_hybrid : per hybrid graph
    graph --> build_inp_mem_hybrid_iswa : per hybrid-iswa graph
    graph --> graph_input_rs

    models --> build_rs : calls per-layer state load/store
    models --> build_rs_inp : calls once per graph
