    %% Inheritance
    M_I <|-- KV : implements
    M_I <|-- DSA : implements
    M_I <|-- ISWA : implements
    M_CTX_I <|-- KV_CTX : implements
    M_CTX_I <|-- DSA_CTX : implements
    M_CTX_I <|-- ISWA_CTX : implements

    %% Composition
    KV --> KV_CELLS : owns n_stream sets
    KV --> KV_EXT : per-cell metadata
    KV --> KV_LAYER : owns per-layer tensors
    KV_LAYER --> GGML : uses for copy ops

    DSA --> DSA_MLA : owns
    DSA --> DSA_LID : owns
    DSA_CTX --> DSA_MLA : delegates
    DSA_CTX --> DSA_LID : delegates

    ISWA --> ISWA_BASE : owns
    ISWA --> ISWA_SWA : owns
    ISWA_CTX --> ISWA_BASE : delegates
    ISWA_CTX --> ISWA_SWA : delegates

    %% Graph integration
    KV_CTX --> INP_KV : mctx ref
    KV_CTX --> INP_K : mctx ref
    DSA_CTX --> INP_DSA : mctx ref
    ISWA_CTX --> INP_ISWA : mctx ref
    KV --> SHIFT_GRAPH : builds shift graph

    %% Sequence ops flow
    API_MEM --> M_I : calls through
    M_I --> KV : seq_rm/cp/add/div
    M_I --> DSA : delegates to 2 caches
    M_I --> ISWA : delegates to 2 caches

    %% Creation flow
    MODEL --> KV : creates for non-SWA non-hybrid
    MODEL --> DSA : creates for DEEPSEEK32
    MODEL --> ISWA : creates for SWA models
    MODEL --> MEM_HYBRID : creates for hybrid arch
    MODEL --> MEM_RECUR : creates for recurrent arch

    %% Feature connections
    KV --> SWA_NONE : uses for SWA config
    KV --> SWA_STD : uses for SWA masking
    KV --> SWA_CHUNK : uses for chunked SWA
    KV --> SWA_SYM : uses for symmetric SWA

    KV --> GGML : tensor copy/clear
    KV --> SCHED : graph allocation/compute

    KV -.- KV_CTX : creates for batch/update/full
    DSA -.- DSA_CTX : creates for batch/update/full
    ISWA -.- ISWA_CTX : creates for batch/update/full

