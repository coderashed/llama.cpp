    %% Inheritance hierarchy
    ModelBase <|-- TextModel : extends
    ModelBase <|-- MmprojModel : extends
    TextModel <|-- LlamaModel : per-arch
    TextModel <|-- QwenModel : per-arch
    TextModel <|-- GemmaModel : per-arch
    gguf_LazyBase <|-- LazyTorchTensor : extends

    %% Composition
    ModelBase o-- GGUFWriter : gguf_writer holds
    ModelBase o-- gguf.TensorNameMap : tensor_map holds
    ModelBase *-- hparams : composition
    ModelBase *-- model_tensors : composition
    GGUFWriter o-- TensorInfo : tensors contain
    GGUFWriter o-- GGUFValue : kv_data contain

    %% Registration pattern
    ModelBase : _model_classes[ModelType][name] = cls
    ModelBase ..> ModelBase : register decorator fills _model_classes
    TextModel ..> LlamaModel : @ModelBase.register("LlamaForCausalLM",...)
    TextModel ..> QwenModel : @ModelBase.register("QWenLMHeadModel",...)
    TextModel ..> GemmaModel : @ModelBase.register("GemmaForCausalLM",...)

