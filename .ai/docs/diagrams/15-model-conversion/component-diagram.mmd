    %% Data flow: HF Download -> Conversion -> GGUF
    E1 -->|remote mode| A1
    E2 --> A1
    E3 --> A1
    E4 --> A3

    A1 --> B1
    A1 --> B5
    B5 -->|arch string| A1
    A1 -->|get_model_class| PER_ARCH

    B1 --> B2
    B1 --> B3
    B2 <-->|subclass| PER_ARCH
    PER_ARCH -->|override set_gguf_parameters<br/>modify_tensors, set_vocab| B2

    A2 -->|LoraModel subclass of TextModel| PER_ARCH

    B1 --> D1
    B4 --> D3

    D1 --> D5
    D1 --> D6
    D1 --> D7
    B2 --> D7
    B1 --> D9
    A1 --> D8
    B1 --> D10

    %% Write pipeline
    A1 -->|model_instance.write()| B1
    B1 -->|prepare_tensors| B1
    B1 -->|gguf_writer.add_tensor| D1
    B1 -->|gguf_writer.write_*| D1
    D1 -->|writes binary| G1
    D1 -->|split files| G2

    %% C++ round-trip
    G1 -->|load model in C++| F1
    F1 --> F2
    F1 --> F3
    F1 --> F4
    F4 -->|rewrites| G1
