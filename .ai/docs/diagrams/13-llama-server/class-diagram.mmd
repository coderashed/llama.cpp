    %% ---------- Relationships ----------
    server_task_result_cmpl_final --|> server_task_result
    server_task_result_cmpl_partial --|> server_task_result
    server_task_result_embd --|> server_task_result
    server_task_result_error --|> server_task_result
    server_task_result_metrics --|> server_task_result
    server_task_result_embd --|> server_task_result

    server_response_reader --> server_queue : wraps
    server_response_reader --> server_response : wraps
    server_response_reader --> task_result_state : tracks

    server_response --> server_task_result : sends/receives

    server_task --> task_params : has
    server_task --> server_tokens : has
    server_task --> task_result_state : create_state()

    server_queue --> server_task : deque

    server_context --> server_queue
    server_context --> server_response
    server_context_meta --> server_chat_params : ref

    server_routes --> server_context_meta : meta
    server_routes --> server_queue : queue_tasks
    server_routes --> server_response : queue_results
    server_routes --> server_schema : calls eval_llama_cmpl_schema

    server_models --> server_model_meta : map
    server_models --> server_child : spawn
    server_models --> server_http_proxy : proxy_request uses

    server_models_routes --> server_models : models

    server_tools --> server_tool : vector

    field_num --|> field
    field_str --|> field
    field_bool --|> field
    field_json --|> field
    field_nested --|> field

    field_eval_context --> task_params : ref
    field_eval_context --> server_schema : eval_llama_cmpl_schema returns

