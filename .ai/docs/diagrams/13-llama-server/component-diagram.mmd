            MTMD[Multimodal Processing<br/>mtmd.h, mtmd-helper.h]
            HTTPLIB[cpp-httplib<br/>external]
        end
        class EXTERNAL external
    end
    class boundary boundary

    %% ---------- Internal Connections ----------
    ROUTE_GET --> SRV
    ROUTE_POST --> SRV
    SRV --> INIT_HTTP
    SRV --> STREAM

    CHAT_HANDLER --> OAI_PARSE_FN
    CHAT_HANDLER --> CMPL_IMPL
    CMPL_HANDLER --> CMPL_IMPL
    INFILL_HANDLER --> CMPL_IMPL

    OAI_PARSE_FN --> PROC_MTMD
    OAI_PARSE_FN --> TOKENIZE_INPUT

    RESP2CHAT --> CHAT_HANDLER
    ANTH2OAI --> ROUTES

    CMPL_IMPL --> TASKS : creates server_task
    CMPL_IMPL --> QUEUE : post_task via reader
    CMPL_IMPL --> RES_CMPL_FINAL : format result

    QUE --> QUE_LOOP
    READER --> QUE
    READER --> RESP
    RESP --> TASKS : receives server_task_result_ptr

    TASK_STRUCT --> PARAMS
    PARAMS --> SCHEMA
    STATE_T --> RES_CMPL_PARTIAL : updates diffs

    CMD_PROC --> SLOT_SYSTEM
    UPDATE_SLOTS --> SLOT_SYSTEM
    UPDATE_SLOTS --> LLAMA_API : llama_decode()

    MODELS_MGR --> CHILD : spawn child process
    MODELS_MGR --> PROXY_REQ : forward request
    PROXY_REQ --> HTTP_PROXY
    CHILD_STATE --> MODELS_META : update status
    CHILD --> CHILD_STATE : notify_to_router()

    TOOL_MGR --> TOOL_READ
    TOOL_MGR --> TOOL_GLOB
    TOOL_MGR --> TOOL_GREP
    TOOL_MGR --> TOOL_EXEC
    TOOL_MGR --> TOOL_WRITE
    TOOL_MGR --> TOOL_EDIT
    TOOL_MGR --> TOOL_DIFF
    TOOL_MGR --> TOOL_DATE

    %% ---------- External Connections ----------
    SLOT_SYSTEM --> LLAMA_API
    PARAMS --> SAMPLING
    SCHEMA --> GRAMMAR
    OAI_PARSE_FN --> CHAT_TMPL : common_chat_templates_apply()
    PROC_MTMD --> MTMD : mtmd_tokenize()
    SRV --> HTTPLIB

