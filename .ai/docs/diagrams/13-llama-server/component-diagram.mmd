    style TASKS fill:#fce4ec
    style CTX fill:#f1f8e9
    style ROUTER fill:#fff9c4
    style TOOLS fill:#efebe9
    style CORSPROXY fill:#fbe9e7
    style EXTERNAL fill:#f5f5f5
