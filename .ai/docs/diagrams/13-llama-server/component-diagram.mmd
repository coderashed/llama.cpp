        class CHAT_CONV subsystem

        %% ---- OAI Parsing ----
        subgraph OAI_PARSE["4. OAI Parsing (server-common.cpp)"]
            direction TB
            OAI_PARSE_FN[oaicompat_chat_params_parse<br/>server-common.cpp:904]
