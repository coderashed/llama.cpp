        %% ---- Task Types ----
        subgraph TASKS["6. Task & Result Types (server-task.h)"]
            direction TB
            TASK_TYPES[server_task_type enum<br/>server-task.h:16-30]
            TASK_STRUCT[server_task - params + tokens<br/>server-task.h:133]
            RES_CMPL_FINAL[server_task_result_cmpl_final<br/>server-task.h:337]
