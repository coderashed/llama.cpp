            GCP[register_gcp_compat() - Vertex AI<br/>server-http.cpp:656]
            UI[Embedded Web UI assets<br/>server-http.cpp:313]
        end
        class HTTP subsystem

        %% ---- Route Handlers ----
        subgraph ROUTES["2. Route Handlers (server-context.cpp)"]
            direction TB
            CHAT_HANDLER[post_chat_completions<br/>server-context.cpp:4683]
            CMPL_HANDLER[post_completions<br/>server-context.cpp:4659]
            INFILL_HANDLER[post_infill<br/>server-context.cpp:4581]
            METRICS_HANDLER[get_metrics<br/>server-context.cpp:4337]
            SLOTS_HANDLER[get_slots / post_slots<br/>server-context.cpp:4442]
            CMPL_IMPL[handle_completions_impl<br/>server-context.cpp:4049]
            COUNT_TOKENS[handle_count_tokens<br/>server-context.cpp:5299]
        end
        class ROUTES subsystem

