        %% ---- External Dependencies ----
        subgraph EXTERNAL["External Dependencies"]
            direction TB
            LLAMA_API[llama.h / llama_context<br/>src/llama-context.cpp]
            SAMPLING[Sampling<br/>common/sampling.h]
            GRAMMAR[Grammar / PEG Parsing<br/>common/grammar.h, peg-parser.h]
