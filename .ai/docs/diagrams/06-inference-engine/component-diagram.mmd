    CtxCtor --> CtxReserve

    CtxReserve --> KVCache : init_full()
    CtxReserve --> CtxGraphReserve
    CtxGraphReserve --> GBuild : build_graph() (worst-case)
    CtxGraphReserve --> BackendSched : reserve / split

    GBuild --> GArch
    GArch --> GCtx
    GCtx --> GEmb
    GCtx --> GPos
    GCtx --> GQKV
    GCtx --> GFFN
    GCtx --> GMoE
    GCtx --> GAttn
    GCtx --> GMHA
    GCtx --> GPool
    GCtx --> GSampl
    GCtx --> GDense
    GCtx --> GResult
    GCtx --> GParams

    GResult --> GraphInputs : has
    GAttn --> IAttnKV : uses
    GAttn --> IAttnNoCache : uses
    GAttn --> IAttnK : uses

    CtxGraphCompute --> BackendSched : ggml_backend_sched_graph_compute_async
    BackendSched --> BackendCPU
    BackendSched --> BackendCUDA
    BackendSched --> BackendMetal
    BackendSched --> BackendVulkan

    KVCache --|> MemI
    KVCache --> KVCells
    KVCache --> SlotFind
    KVCache --> InitBatch
    KVCache --> InitFull
    KVCache --> CpyKV
