    class kvarn_normalize_columns {
        +float* T           // tile, modified in-place
        +float* S_c         // [C] column scale output, accumulated
        +int R, int C
        +float c_min, float c_max
        +void kvarn_normalize_columns(...)
    }
    note "src/llama-kvarn.cpp: static function\nFor each column j:\n  mean = log(mean(abs(T[:,j])))\n  clamp(mean, c_min, c_max)\n  T[:,j] -= mean\n  S_c[j] *= exp(mean)"

    class kvarn_normalize_rows {
        +float* T
        +float* S_r
